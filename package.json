{
  "name": "form-of-learning",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:ui":     "pnpm --filter form-of-learning-ui run dev",
    "dev:worker": "pnpm --filter form-of-learning-worker run dev",
    "build":      "pnpm --filter form-of-learning-ui run build",
    "deploy":     "pnpm run build && pnpm --filter form-of-learning-worker run deploy"
  }
}
